<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LaptopQA.Mac.MainWindow" Title="Laptop QA Testing" Width="1280" Height="720"
        MinWidth="960" MinHeight="540" CanResize="False" WindowDecorations="None" WindowStartupLocation="CenterScreen"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Icon="avares://LaptopQA.Mac/Assets/app-icon.png">
  <Window.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#06141B"/><SolidColorBrush x:Key="MutedBrush" Color="#1D323C"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#004F4A"/><SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PanelStroke" Color="#7F969F"/><SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#60757E"/><SolidColorBrush x:Key="ResetBrush" Color="#203741"/><SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#6682949B"/><SolidColorBrush x:Key="PassBrush" Color="#2F855A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#9B3036"/><SolidColorBrush x:Key="PowerBrush" Color="#EEF4F2"/>
    <SolidColorBrush x:Key="TabForegroundBrush" Color="#18333D"/><SolidColorBrush x:Key="FoldersTabBrush" Color="#D1DDD9"/><SolidColorBrush x:Key="NotesTabBrush" Color="#C5D5D2"/><SolidColorBrush x:Key="ActivityTabBrush" Color="#B8C8CB"/><SolidColorBrush x:Key="HardwareTabBrush" Color="#AFC1C5"/>
    <SolidColorBrush x:Key="FinalCheckBoxBrush" Color="#C8DBD7"/><SolidColorBrush x:Key="FinalCheckMarkBrush" Color="#12633D"/>
    <SolidColorBrush x:Key="DrawerBrush" Color="#FFFDFCF8"/><SolidColorBrush x:Key="ToolTipBrush" Color="#F2F6F4"/><SolidColorBrush x:Key="SelectionBrush" Color="#2F6F68"/><SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="ShellBrush" StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#FAFAF6" Offset="0"/><GradientStop Color="#F0F1EC" Offset="0.58"/><GradientStop Color="#E3E6E0" Offset="1"/></LinearGradientBrush>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="SelectableTextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/><Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionTextBrush}"/></Style>
    <Style Selector="Button.action"><Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter></Style>
    <Style Selector="Button.folderAction"><Setter Property="Width" Value="292"/><Setter Property="Height" Value="50"/><Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter></Style>
    <Style Selector="Button.folderAction:pointerover"><Setter Property="Opacity" Value="0.90"/></Style>
    <Style Selector="Button.folderAction:pressed"><Setter Property="Opacity" Value="0.76"/></Style>
    <Style Selector="Button.action:disabled"><Setter Property="Opacity" Value="0.36"/></Style>
    <Style Selector="Button.unavailable"><Setter Property="IsEnabled" Value="True"/><Setter Property="IsHitTestVisible" Value="True"/><Setter Property="Cursor" Value="Arrow"/><Setter Property="Opacity" Value="0.38"/></Style>
    <Style Selector="Button.unavailable:pointerover"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Opacity" Value="0.38"/></Style><Style Selector="Button.unavailable:pressed"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Opacity" Value="0.38"/></Style>
    <Style Selector="Button.unavailable.reset:pointerover"><Setter Property="Background" Value="{DynamicResource ResetBrush}"/></Style><Style Selector="Button.unavailable.reset:pressed"><Setter Property="Background" Value="{DynamicResource ResetBrush}"/></Style>
    <Style Selector="Button.unavailable.pass:pointerover"><Setter Property="Background" Value="{DynamicResource PassBrush}"/></Style><Style Selector="Button.unavailable.pass:pressed"><Setter Property="Background" Value="{DynamicResource PassBrush}"/></Style>
    <Style Selector="Button.unavailable.danger:pointerover"><Setter Property="Background" Value="{DynamicResource DangerBrush}"/></Style><Style Selector="Button.unavailable.danger:pressed"><Setter Property="Background" Value="{DynamicResource DangerBrush}"/></Style>
    <Style Selector="Button.reset"><Setter Property="Background" Value="{DynamicResource ResetBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.pass"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource PassBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.power"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PowerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="27"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="28" BoxShadow="0 2 10 0 #1F0B2028"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter></Style>
    <Style Selector="Button.headerIcon"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Template"><ControlTemplate><Border Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter></Style>
    <Style Selector="Button.headerIcon:pointerover"><Setter Property="Opacity" Value="0.72"/></Style>
    <Style Selector="Button.headerIcon:pressed"><Setter Property="Opacity" Value="0.48"/></Style>
    <Style Selector="Button.macControl"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Foreground" Value="#85000000"/><Setter Property="BorderBrush" Value="#30000000"/><Setter Property="BorderThickness" Value="0.7"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" BoxShadow="0 1 3 0 #26000000"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter></Style>
    <Style Selector="Button.macClose"><Setter Property="Background" Value="#FF5F57"/></Style><Style Selector="Button.macMinimize"><Setter Property="Background" Value="#FEBC2E"/></Style>
    <Style Selector="Button.macControl:pointerover"><Setter Property="Opacity" Value="0.82"/></Style><Style Selector="Button.macControl:pressed"><Setter Property="Opacity" Value="0.62"/></Style>
    <Style Selector="Button.sideTab"><Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="12,0,0,12"/><Setter Property="Padding" Value="3"/><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter></Style>
    <Style Selector="Button.foldersTab"><Setter Property="Background" Value="{DynamicResource FoldersTabBrush}"/></Style><Style Selector="Button.notesTab"><Setter Property="Background" Value="{DynamicResource NotesTabBrush}"/></Style><Style Selector="Button.activityTab"><Setter Property="Background" Value="{DynamicResource ActivityTabBrush}"/></Style><Style Selector="Button.hardwareTab"><Setter Property="Background" Value="{DynamicResource HardwareTabBrush}"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="26"/><Setter Property="Padding" Value="18,8"/><Setter Property="BoxShadow" Value="0 8 18 0 #33142128"/></Style>
    <Style Selector="Border.card.drawerPanel"><Setter Property="Background" Value="{DynamicResource DrawerBrush}"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/><Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionTextBrush}"/></Style>
    <Style Selector="ToolTip"><Setter Property="Background" Value="{DynamicResource ToolTipBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,6"/></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,6"/><Setter Property="Template"><ControlTemplate><Border x:Name="FinalCheckOuter" Background="Transparent" Padding="{TemplateBinding Padding}"><Grid ColumnDefinitions="30,*"><Border x:Name="FinalCheckBox" Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1.2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="FinalCheckMark" Data="M1.5,5.2 L4.5,8.2 L9.5,1.4" IsVisible="False" Width="11" Height="10" Stretch="Fill" Stroke="{DynamicResource FinalCheckMarkBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></Setter></Style>
    <Style Selector="CheckBox:checked /template/ Border#FinalCheckBox"><Setter Property="Background" Value="{DynamicResource FinalCheckBoxBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource FinalCheckBoxBrush}"/></Style>
    <Style Selector="CheckBox:checked /template/ Path#FinalCheckMark"><Setter Property="IsVisible" Value="True"/></Style>
  </Window.Styles>
  <Border CornerRadius="18" ClipToBounds="True" Background="{DynamicResource ShellBrush}">
  <Viewbox Stretch="Fill">
  <Grid x:Name="Shell" Width="1280" Height="720" Background="{DynamicResource ShellBrush}" RowDefinitions="104,*">
    <Canvas Grid.RowSpan="2" IsHitTestVisible="False"><Path x:Name="WavePath" Data="M -20,540 C 230,460 470,650 760,555 C 980,480 1120,620 1320,550 L1320,800 L-20,800 Z" Fill="#28A4AFB8"/></Canvas>
    <Canvas Grid.Row="0" Margin="28,8,28,0" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
      <Button x:Name="MacMinimizeButton" Classes="macControl macMinimize" Canvas.Left="1178" Canvas.Top="27" Click="MacMinimizeButton_Click" PointerEntered="MacWindowControl_PointerEntered" PointerExited="MacWindowControl_PointerExited" ToolTip.Tip="Minimize Laptop QA"><Border x:Name="MacMinimizeIcon" Width="8" Height="1.4" CornerRadius="0.7" Background="#85000000" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/></Button>
      <Button x:Name="MacCloseButton" Classes="macControl macClose" Canvas.Left="1204" Canvas.Top="27" Click="MacCloseButton_Click" PointerEntered="MacWindowControl_PointerEntered" PointerExited="MacWindowControl_PointerExited" ToolTip.Tip="Close Laptop QA"><Viewbox x:Name="MacCloseIcon" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"><Path Width="8" Height="8" Stretch="Fill" Data="M1,1 L7,7 M7,1 L1,7" Stroke="#85000000" StrokeThickness="1.25" StrokeLineCap="Round"/></Viewbox></Button>
      <Button Classes="headerIcon" Canvas.Left="0" Canvas.Top="20" Width="34" Height="32" Click="SettingsButton_Click" ToolTip.Tip="Open Config"><Viewbox Width="17" Height="17"><Path Data="M3,5 L21,5 M3,12 L21,12 M3,19 L21,19" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeLineCap="Round"/></Viewbox></Button>
      <TextBlock Text="Laptop QA Testing" Canvas.Left="54" Canvas.Top="14" Width="360" FontSize="28" FontWeight="Light"/>
      <SelectableTextBlock x:Name="HeaderDeviceName" Text="Device Name: cache not loaded" Canvas.Left="56" Canvas.Top="52" Width="175" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold"/>
      <SelectableTextBlock x:Name="HeaderSerial" Text="Service Tag: cache not loaded" Canvas.Left="235" Canvas.Top="52" Width="145" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold"/>
      <SelectableTextBlock x:Name="HeaderAsset" Text="Asset: cache not loaded" Canvas.Left="384" Canvas.Top="52" Width="145" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold"/>
      <SelectableTextBlock x:Name="HeaderWarranty" Text="Warranty: cache not loaded" Canvas.Left="56" Canvas.Top="72" Width="170" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold"/>
      <SelectableTextBlock x:Name="HeaderTechnician" Text="Technician: not set" Canvas.Left="230" Canvas.Top="72" Width="190" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="HeaderBatteryDots" Text="○○○○" Canvas.Left="424" Canvas.Top="69" Width="62" Foreground="{DynamicResource MutedBrush}" FontSize="15" FontWeight="Bold" ToolTip.Tip="The rating and circles come from the Dell diagnostics log. The percentage continues to use cached Windows battery capacity data."/>
      <SelectableTextBlock x:Name="HeaderBattery" Text="Battery Health: cache not loaded" Canvas.Left="490" Canvas.Top="72" Width="340" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold" ToolTip.Tip="The rating comes from the Dell diagnostics log. The percentage continues to use cached Windows battery capacity data."/>
    </Canvas>
      <Grid Grid.Row="1" Margin="54,0,0,26" ColumnDefinitions="740,36,396" HorizontalAlignment="Left">
        <StackPanel Grid.Column="0" Spacing="8">
          <Border Classes="card" Height="74" Padding="0"><Canvas><TextBlock Text="1. Start New QA" Canvas.Left="24" Canvas.Top="13" FontSize="16" FontWeight="Bold"/><SelectableTextBlock Text="Begin a fresh QA session for the next laptop." Canvas.Left="70" Canvas.Top="44" Width="390" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold"/><Button Classes="action danger unavailable" Canvas.Left="560" Canvas.Top="20" Width="150" Height="34" Content="Start New QA" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Start New QA is available in the Windows app."/></Canvas></Border>
          <Border Classes="card" Height="112" Padding="0"><Canvas><TextBlock Text="2. Network Check" Canvas.Left="24" Canvas.Top="13" FontSize="16" FontWeight="Bold"/><Button Classes="action unavailable" Canvas.Left="648" Canvas.Top="14" Width="72" Height="62" Content="Start" FontSize="12" FontWeight="Bold" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Network checks use the cached Windows result."/><TextBlock x:Name="WifiIcon" Text="—" Canvas.Left="28" Canvas.Top="44" Width="32" FontSize="20" FontWeight="Bold"/><SelectableTextBlock x:Name="WifiMain" Text="Wi-Fi cache unavailable" Canvas.Left="70" Canvas.Top="42" Width="470" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><SelectableTextBlock x:Name="WifiDetail" Text="No cached Windows result." Canvas.Left="70" Canvas.Top="61" Width="470" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EthernetIcon" Text="—" Canvas.Left="28" Canvas.Top="78" Width="32" FontSize="20" FontWeight="Bold"/><SelectableTextBlock x:Name="EthernetMain" Text="Ethernet cache unavailable" Canvas.Left="70" Canvas.Top="76" Width="530" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><SelectableTextBlock x:Name="EthernetDetail" Text="No cached Windows result." Canvas.Left="70" Canvas.Top="95" Width="640" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/></Canvas></Border>
          <Border Classes="card" Height="82" Padding="0"><Canvas><TextBlock Text="3. Camera Test" Canvas.Left="24" Canvas.Top="11" FontSize="16" FontWeight="Bold"/><Button Classes="action unavailable" Canvas.Left="566" Canvas.Top="10" Width="72" Height="62" Content="Start" FontSize="12" FontWeight="Bold" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Start or reset the camera test in the Windows app."/><Button Classes="action pass unavailable" Canvas.Left="648" Canvas.Top="10" Width="72" Height="28" Content="Pass" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Mark the camera test in the Windows app."/><Button Classes="action danger unavailable" Canvas.Left="648" Canvas.Top="44" Width="72" Height="28" Content="Fail" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Mark the camera test in the Windows app."/><TextBlock x:Name="CameraIcon" Text="—" Canvas.Left="28" Canvas.Top="40" Width="32" FontSize="20" FontWeight="Bold"/><SelectableTextBlock x:Name="CameraMain" Text="Camera cache unavailable" Canvas.Left="70" Canvas.Top="36" Width="484" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><SelectableTextBlock x:Name="CameraDetail" Text="No cached Windows result." Canvas.Left="70" Canvas.Top="55" Width="484" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/></Canvas></Border>
          <Border Classes="card" Height="88" Padding="0"><Canvas><TextBlock Text="4. External Video" Canvas.Left="24" Canvas.Top="11" FontSize="16" FontWeight="Bold"/><Button Classes="action unavailable" Canvas.Left="566" Canvas.Top="10" Width="72" Height="62" Content="Start" FontSize="12" FontWeight="Bold" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Start or reset external display testing in the Windows app."/><Button Classes="action unavailable" Canvas.Left="648" Canvas.Top="10" Width="72" Height="28" Content="Ignore" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Ignore is for devices that do not have an external video port. This action is disabled on macOS."/><Button Classes="action danger unavailable" Canvas.Left="648" Canvas.Top="44" Width="72" Height="28" Content="Fail" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Mark external video in the Windows app."/><TextBlock x:Name="ExternalIcon" Text="—" Canvas.Left="28" Canvas.Top="39" Width="32" FontSize="20" FontWeight="Bold"/><SelectableTextBlock x:Name="ExternalMain" Text="External video cache unavailable" Canvas.Left="70" Canvas.Top="35" Width="402" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><SelectableTextBlock x:Name="ExternalDetail" Text="No cached Windows result." Canvas.Left="70" Canvas.Top="54" Width="402" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/></Canvas></Border>
          <Border Classes="card" Height="88" Padding="0"><Canvas><TextBlock Text="5. Keyboard Test" Canvas.Left="24" Canvas.Top="11" FontSize="16" FontWeight="Bold"/><Button Classes="action unavailable" Canvas.Left="566" Canvas.Top="10" Width="72" Height="62" Content="Start" FontSize="12" FontWeight="Bold" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Start or reset the keyboard test in the Windows app."/><Button Classes="action pass unavailable" Canvas.Left="648" Canvas.Top="10" Width="72" Height="28" Content="Pass" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Mark the keyboard test in the Windows app."/><Button Classes="action danger unavailable" Canvas.Left="648" Canvas.Top="44" Width="72" Height="28" Content="Fail" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Mark the keyboard test in the Windows app."/><TextBlock x:Name="KeyboardIcon" Text="—" Canvas.Left="28" Canvas.Top="38" Width="32" FontSize="20" FontWeight="Bold"/><SelectableTextBlock x:Name="KeyboardMain" Text="Keyboard cache unavailable" Canvas.Left="70" Canvas.Top="34" Width="484" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><SelectableTextBlock x:Name="KeyboardDetail" Text="No cached Windows result." Canvas.Left="70" Canvas.Top="53" Width="484" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/></Canvas></Border>
          <Border Classes="card" Height="106" Padding="0"><Canvas><TextBlock Text="6. Diagnostics" Canvas.Left="24" Canvas.Top="13" FontSize="16" FontWeight="Bold"/><Button Classes="action" Canvas.Left="566" Canvas.Top="10" Width="72" Height="28" Content="Browse" Click="DiagnosticsBrowseButton_Click" ToolTip.Tip="Select and parse a Dell preboot diagnostics log."/><Button x:Name="RawLogButton" Classes="action unavailable" Canvas.Left="648" Canvas.Top="10" Width="72" Height="28" Content="Raw Log" Click="RawLogButton_Click" ToolTip.Tip="View the raw diagnostics log. Load a log first if none is cached."/><TextBlock x:Name="DiagnosticsIcon" Text="—" Canvas.Left="28" Canvas.Top="47" Width="32" FontSize="20" FontWeight="Bold"/><SelectableTextBlock x:Name="DiagnosticsMain" Text="Diagnostics cache unavailable" Canvas.Left="70" Canvas.Top="45" Width="560" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><SelectableTextBlock x:Name="DiagnosticsDetail" Text="No cached Windows result." Canvas.Left="70" Canvas.Top="64" Width="650" Height="34" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></Canvas></Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="12">
          <Border Classes="card" Height="112" Padding="0"><Canvas><TextBlock Text="7. USB Port Test" Canvas.Left="24" Canvas.Top="11" FontSize="16" FontWeight="Bold"/><WrapPanel x:Name="UsbPortIndicatorsPanel" Canvas.Left="24" Canvas.Top="42" Width="348" Height="62" Orientation="Horizontal"/></Canvas></Border>
          <Border Classes="card" Height="96">
            <Grid RowDefinitions="Auto,30,30" RowSpacing="1">
              <TextBlock Text="8. Trackpad &amp; Physical Condition" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
              <Grid Grid.Row="1" ColumnDefinitions="24,*,60,60" ColumnSpacing="8">
                <TextBlock x:Name="TrackpadStatus" Text="-" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Trackpad Working" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Classes="action pass" Content="Pass" Height="28" Click="TrackpadPassButton_Click"/>
                <Button Grid.Column="3" Classes="action danger" Content="Fail" Height="28" Click="TrackpadFailButton_Click"/>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="24,*,60,60" ColumnSpacing="8">
                <TextBlock x:Name="PhysicalConditionStatus" Text="-" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Checked Physical Condition" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Classes="action pass" Content="Pass" Height="28" Click="PhysicalConditionPassButton_Click"/>
                <Button Grid.Column="3" Classes="action danger" Content="Fail" Height="28" Click="PhysicalConditionFailButton_Click"/>
              </Grid>
            </Grid>
          </Border>
          <Border Classes="card" Height="170">
            <Grid RowDefinitions="Auto,28,28,28,26" RowSpacing="1">
              <TextBlock Text="9. Final Checks" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
              <Grid Grid.Row="1" ColumnDefinitions="24,*">
                <CheckBox x:Name="RemovedUserCheck" Padding="4" ToolTip.Tip="Mark this complete after removing the laptop from Intune."/>
                <Button Grid.Column="1" Classes="action" HorizontalAlignment="Left" Padding="8,4" Content="Remove User from Laptop in Intune" FontSize="12.5" Click="RemoveUserFromIntuneButton_Click" ToolTip.Tip="Open Intune Windows Devices in a new tab and copy this laptop's service tag."/>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="24,*">
                <CheckBox x:Name="HashGroupTagCheck" Padding="4" ToolTip.Tip="Mark this complete after confirming the group tag in Intune."/>
                <Button Grid.Column="1" Classes="action" HorizontalAlignment="Left" Padding="8,4" Content="Check Hash and Group Tag" FontSize="12.5" Click="CheckHashGroupTagButton_Click" ToolTip.Tip="Open Intune Autopilot Devices in a new tab and copy this laptop's service tag."/>
              </Grid>
              <Grid Grid.Row="3" ColumnDefinitions="24,*">
                <CheckBox x:Name="StockroomsCheck" Padding="4" ToolTip.Tip="Mark this complete after updating stockroom inventory."/>
                <Button Grid.Column="1" Classes="action" HorizontalAlignment="Left" Padding="8,4" Content="Update Stockrooms" FontSize="12.5" Click="UpdateStockroomsButton_Click" ToolTip.Tip="Open the ServiceNow hardware list in a new tab and copy this laptop's service tag."/>
              </Grid>
              <CheckBox Grid.Row="4" x:Name="CleanedCheck" Content="Cleaned Laptop" FontSize="12.5" Padding="4" ToolTip.Tip="Confirm the laptop was physically cleaned."/>
            </Grid>
          </Border>
          <Border Classes="card" Height="64"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="10. QA Output" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="action" Width="82" Height="34" Content="QA Sheet" Click="QaSheetButton_Click" Margin="0,0,6,0" ToolTip.Tip="Generate and open the QA sheet from the cached Windows workflow and edits made on this Mac."/><Button Grid.Column="2" Classes="action" Width="82" Height="34" Content="ServiceNow" Click="ServiceNowButton_Click" ToolTip.Tip="Copy the ServiceNow request details and open ServiceNow."/></Grid></Border>
          <Border Classes="card" Height="64" Padding="0"><Canvas><TextBlock Text="BIOS Settings" Canvas.Left="24" Canvas.Top="13" FontSize="16" FontWeight="Bold"/><SelectableTextBlock x:Name="BiosStatusText" Text="BIOS cache unavailable" Canvas.Left="24" Canvas.Top="38" Width="135" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/><Button Classes="action unavailable" Canvas.Left="168" Canvas.Top="13" Width="96" Height="32" Content="Factory Settings" FontSize="9.8" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Load factory BIOS settings from the Windows app."/><Button Classes="action reset unavailable" Canvas.Left="276" Canvas.Top="13" Width="96" Height="32" Content="Secure Boot" FontSize="10.3" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Change Secure Boot from the Windows app."/></Canvas></Border>
          <Button Classes="action unavailable" Width="230" Height="32" HorizontalAlignment="Center" Content="Export Hash" FontSize="11" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Hardware hash collection is available in the Windows app."/>
        </StackPanel>
      </Grid>

    <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="-10" Panel.ZIndex="10">
      <Button x:Name="FoldersDrawerTab" Classes="sideTab foldersTab" Width="42" Height="104" Click="FoldersDrawerButton_Click" ToolTip.Tip="Show or hide folders"><LayoutTransformControl><LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform><TextBlock Text="Folders" Foreground="{DynamicResource TabForegroundBrush}" FontSize="10.5" FontWeight="Bold"/></LayoutTransformControl></Button>
      <Button x:Name="NotesDrawerTab" Classes="sideTab notesTab" Width="42" Height="104" Click="NotesDrawerButton_Click" ToolTip.Tip="Show or hide editable QA notes"><LayoutTransformControl><LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform><TextBlock Text="Notes" Foreground="{DynamicResource TabForegroundBrush}" FontSize="10.5" FontWeight="Bold"/></LayoutTransformControl></Button>
      <Button x:Name="ActivityDrawerTab" Classes="sideTab activityTab" Width="42" Height="104" Click="ActivityDrawerButton_Click" ToolTip.Tip="Show or hide the activity log"><LayoutTransformControl><LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform><TextBlock Text="Activity" Foreground="{DynamicResource TabForegroundBrush}" FontSize="10.5" FontWeight="Bold"/></LayoutTransformControl></Button>
      <Button x:Name="HardwareDrawerTab" Classes="sideTab hardwareTab" Width="42" Height="104" Click="HardwareDrawerButton_Click" ToolTip.Tip="Show or hide cached Windows hardware"><LayoutTransformControl><LayoutTransformControl.LayoutTransform><RotateTransform Angle="-90"/></LayoutTransformControl.LayoutTransform><TextBlock Text="Hardware" Foreground="{DynamicResource TabForegroundBrush}" FontSize="10.5" FontWeight="Bold"/></LayoutTransformControl></Button>
    </StackPanel>

    <Border x:Name="FoldersPanel" Grid.Row="1" Classes="card drawerPanel" Width="396" Margin="0,12,42,24" Padding="28,20" HorizontalAlignment="Right" IsVisible="False">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Folders" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="headerIcon" Width="28" Height="28" FontSize="12" FontWeight="Bold" Content="X" Click="CloseDrawerButton_Click" ToolTip.Tip="Close folders"/></Grid>
        <TextBlock Grid.Row="1" Text="Open saved QA files and supporting records." Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0"/>
        <StackPanel Grid.Row="2" Width="292" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Classes="folderAction" Content="QA Sheets" Click="OpenQaSheetsFolderButton_Click" ToolTip.Tip="Open the QA sheets folder"/>
          <Button Classes="folderAction" Content="Activity" Click="OpenActivityFolderButton_Click" ToolTip.Tip="Open the activity records folder"/>
          <Button Classes="folderAction" Content="Logs" Click="OpenLogsFolderButton_Click" ToolTip.Tip="Open the application and error logs folder"/>
          <Button Classes="folderAction" Content="Hash" Click="OpenHashFolderButton_Click" ToolTip.Tip="Open the cached hash folder"/>
          <Button Classes="folderAction" Content="Hardware" Click="OpenHardwareFolderButton_Click" ToolTip.Tip="Open the cached hardware folder"/>
          <Button Classes="folderAction" Content="Diagnostics" Click="OpenDiagnosticsFolderButton_Click" ToolTip.Tip="Open the FAT32 diagnostics drive"/>
          <Button Classes="folderAction" Content="Camera Roll" Click="OpenCameraRollFolderButton_Click" ToolTip.Tip="Open the Camera Roll location saved in Config when it is available on this Mac"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="NotesPanel" Grid.Row="1" Classes="card drawerPanel" Width="396" Margin="0,12,42,24" HorizontalAlignment="Right" IsVisible="False">
      <Grid RowDefinitions="Auto,14,Auto,14,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="QA Notes" FontSize="16" FontWeight="Bold"/><Button Grid.Column="1" Classes="action" Content="X" Click="CloseDrawerButton_Click" ToolTip.Tip="Close notes"/></Grid><StackPanel Grid.Row="2"><TextBlock Text="RMA Issues" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="RmaIssuesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ToolTip.Tip="Edit RMA issues used on the QA sheet"/></StackPanel><StackPanel Grid.Row="4"><TextBlock Text="Repair Notes" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="RepairNotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ToolTip.Tip="Edit repair notes used on the QA sheet"/></StackPanel></Grid>
    </Border>
    <Border x:Name="ActivityPanel" Grid.Row="1" Classes="card drawerPanel" Width="396" Margin="0,12,42,24" HorizontalAlignment="Right" IsVisible="False">
      <Grid RowDefinitions="Auto,12,*"><Grid ColumnDefinitions="*,Auto,Auto,Auto"><TextBlock Text="Activity" FontSize="16" FontWeight="Bold"/><Button Grid.Column="1" Classes="action" Content="Copy" Click="ActivityCopyButton_Click" Margin="0,0,6,0" ToolTip.Tip="Copy the activity log"/><Button Grid.Column="2" Classes="action" Content="Save" Click="ActivitySaveButton_Click" Margin="0,0,6,0" ToolTip.Tip="Save the activity log"/><Button Grid.Column="3" Classes="action" Content="X" Click="CloseDrawerButton_Click" ToolTip.Tip="Close activity"/></Grid><TextBox Grid.Row="2" x:Name="ActivityBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Menlo,Consolas"/></Grid>
    </Border>
    <Border x:Name="HardwarePanel" Grid.Row="1" Classes="card drawerPanel" Width="396" Margin="0,12,42,24" HorizontalAlignment="Right" IsVisible="False">
      <Grid RowDefinitions="Auto,12,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Hardware" FontSize="16" FontWeight="Bold"/><Button Grid.Column="1" Classes="action" Content="X" Click="CloseDrawerButton_Click" ToolTip.Tip="Close hardware"/></Grid><TextBox Grid.Row="2" x:Name="HardwareBox" IsReadOnly="True" Focusable="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Menlo,Consolas" ToolTip.Tip="Select hardware text to copy it"/></Grid>
    </Border>
    <Button Grid.Row="1" Classes="power unavailable" Width="56" Height="56" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,20" Click="UnavailableOnMacButton_Click" ToolTip.Tip="Disabled on macOS. Power controls are available in the Windows app."><Viewbox Width="26" Height="26"><Viewbox.RenderTransform><TranslateTransform X="-1" Y="-1"/></Viewbox.RenderTransform><Path Fill="{DynamicResource TextBrush}" Data="M13,3 L11,3 L11,13 L13,13 Z M17.83,5.17 L16.41,6.59 C17.99,7.86 19,9.81 19,12 C19,15.87 15.87,19 12,19 C8.13,19 5,15.87 5,12 C5,9.81 6.01,7.86 7.59,6.59 L6.17,5.17 C4.23,6.82 3,9.27 3,12 C3,16.97 7.03,21 12,21 C16.97,21 21,16.97 21,12 C21,9.27 19.77,6.82 17.83,5.17 Z"/></Viewbox></Button>
  </Grid>
  </Viewbox>
  </Border>
</Window>
