                    <Button x:Name="FoldersDrawerButton" Canvas.Left="1238" Canvas.Top="192" Panel.ZIndex="3" Width="42" Height="112" Padding="0" Style="{StaticResource FolderTabButton}" Click="FoldersDrawerButton_Click" ToolTip="Show folders">
                        <Grid>
                            <TextBlock Text="Folders" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Border x:Name="CurrentBatteryPanel" Canvas.Left="1165" Canvas.Top="47" Width="78" Height="24" Background="Transparent" BorderThickness="0" ToolTip="Current battery state">
                        <Canvas>
                            <Canvas x:Name="CurrentBatteryIconCanvas" Canvas.Left="0" Canvas.Top="3" Width="38" Height="20">
                                <Border x:Name="CurrentBatteryShell" Canvas.Left="0" Canvas.Top="3" Width="31" Height="15" CornerRadius="5" Background="{DynamicResource AccentBrush}"/>
                                <Border x:Name="CurrentBatteryCap" Canvas.Left="29" Canvas.Top="8" Width="5" Height="5" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"/>
                                <Border x:Name="CurrentBatteryChamber" Canvas.Left="4" Canvas.Top="6.5" Width="23" Height="9" CornerRadius="2.5" Background="#666873"/>
                                <Rectangle x:Name="CurrentBatteryFill" Canvas.Left="6" Canvas.Top="8" Width="0" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}"/>
                                <Path x:Name="CurrentBatteryChargeBolt" Data="M 17,3 L 12,11 H 15 L 13.5,18 L 22,8.5 H 18 Z" Fill="#1E2930" Visibility="Collapsed"/>
                            </Canvas>
                            <TextBlock x:Name="CurrentBatteryPercent" Text="--%" Canvas.Left="38" Canvas.Top="5" Width="34" Height="14" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="CurrentBatteryStatusText" Text="" Visibility="Collapsed"/>
                        </Canvas>
                    </Border>
                    <Button x:Name="PowerButton" Canvas.Left="1208" Canvas.Top="640" Width="56" Height="56" Style="{StaticResource PowerRoundButton}" ToolTip="Power menu" Click="PowerButton_Click">
                        <Canvas Width="32" Height="32">
                            <TextBlock Text="&#xE7E8;" Canvas.Left="3" Canvas.Top="2" Width="26" Height="28" FontFamily="Segoe MDL2 Assets" FontSize="25" TextAlignment="Center"/>
                        </Canvas>
                    </Button>
                </Canvas>

                <Border x:Name="StartupSplashOverlay" Panel.ZIndex="50" Background="{DynamicResource SplashOverlayBrush}" Visibility="Visible">
                    <Grid>
                        <Border x:Name="StartupSplashCard" Width="470" Height="244" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="24" Background="{DynamicResource ActivityPanelBrush}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.30" Color="#142128"/>
                            </Border.Effect>
                            <Canvas>
                                <TextBlock x:Name="StartupSplashTitle" Text="Laptop QA Testing" Canvas.Left="36" Canvas.Top="34" Width="398" Height="42"
                                           Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock x:Name="StartupSplashDots" Text="&#x25CF; &#x25CF; &#x25CF;" Canvas.Left="36" Canvas.Top="86" Width="398" Height="28"
                                           Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe UI Symbol" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                                <TextBlock x:Name="StartupSplashStatus" Text="Loading..." Canvas.Left="44" Canvas.Top="122" Width="382" Height="52"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <ProgressBar x:Name="StartupSplashProgress" Canvas.Left="88" Canvas.Top="192" Width="294" Height="8"
                                             IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource DarkGlassBrush}"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</Window>
