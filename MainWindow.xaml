<Window x:Class="LaptopQA.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laptop QA Testing"
        Width="1280"
        Height="720"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="assets/app-icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F7F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#B9C7CB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A2E6DD"/>
        <SolidColorBrush x:Key="PanelStroke" Color="#6682949B"/>
        <SolidColorBrush x:Key="InputStrokeBrush" Color="#3FAED5DF"/>
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#60757E"/>
        <SolidColorBrush x:Key="ResetButtonBrush" Color="#263D46"/>
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#6682949B"/>
        <SolidColorBrush x:Key="DangerButtonBrush" Color="#8A4646"/>
        <SolidColorBrush x:Key="OkButtonBrush" Color="#12633D"/>
        <SolidColorBrush x:Key="PowerButtonBrush" Color="#263D46"/>
        <SolidColorBrush x:Key="PowerButtonBorderBrush" Color="#6682949B"/>
        <SolidColorBrush x:Key="ActivityPanelBrush" Color="#FF2A414A"/>
        <SolidColorBrush x:Key="SplashOverlayBrush" Color="#F0253640"/>
        <SolidColorBrush x:Key="NoteInputBrush" Color="#A01D3038"/>
        <SolidColorBrush x:Key="FinalCheckCheckedBrush" Color="#3317C9BD"/>
        <SolidColorBrush x:Key="FinalCheckCheckedBoxBrush" Color="#A2E6DD"/>
        <SolidColorBrush x:Key="FinalCheckCheckMarkBrush" Color="#102A2D"/>
        <SolidColorBrush x:Key="FinalCheckUncheckedBrush" Color="#241D3038"/>
        <SolidColorBrush x:Key="FinalCheckHoverBrush" Color="#34173D43"/>
        <SolidColorBrush x:Key="FinalCheckBorderBrush" Color="#6682949B"/>
        <SolidColorBrush x:Key="CachedSessionHoverBrush" Color="#60757E"/>
        <SolidColorBrush x:Key="CachedSessionSelectedBrush" Color="#263D46"/>
        <SolidColorBrush x:Key="CachedSessionTextBrush" Color="#F3F7F8"/>
        <SolidColorBrush x:Key="CachedSessionSelectedTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SectionSurfaceBrush" Color="#465B63"/>

        <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#253640" Offset="0"/>
            <GradientStop Color="#314A55" Offset="0.58"/>
            <GradientStop Color="#526A70" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B536B72" Offset="0"/>
            <GradientStop Color="#463F5962" Offset="0.52"/>
            <GradientStop Color="#3831444D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DarkGlassBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A01D3038" Offset="0"/>
            <GradientStop Color="#7F142730" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UtilityPanelBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8A142933" Offset="0"/>
            <GradientStop Color="#74213842" Offset="0.55"/>
            <GradientStop Color="#662D4D55" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SectionSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="8" Opacity="0.20" Color="#142128"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderFlyoutButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.90"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.76"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResetButton" BasedOn="{StaticResource PrimaryButton}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource ResetButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PassButton" BasedOn="{StaticResource PrimaryButton}" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource OkButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DangerButton" BasedOn="{StaticResource PrimaryButton}" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource DangerButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="HeaderShadowButton" BasedOn="{StaticResource PrimaryButton}" TargetType="{x:Type Button}">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.24" Color="#0B2028"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderIconButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PowerRoundButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PowerButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PowerButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12" Color="#0B2028"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="28" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectableHeaderText" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Command="ApplicationCommands.Copy"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectableMainText" BasedOn="{StaticResource SelectableHeaderText}" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SelectableDetailText" BasedOn="{StaticResource SelectableHeaderText}" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="FolderTabButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="TabRoot">
                            <Path x:Name="TabShape"
                                  Data="M 10,0 L42,0 L42,112 L10,112 C4,112 0,108 0,102 L0,10 C0,4 4,0 10,0 Z"
                                  Fill="{TemplateBinding Background}"
                                  Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="{TemplateBinding BorderThickness}"
                                  Stretch="Fill"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabRoot" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FinalCheckToggle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxBox" Width="16" Height="16" CornerRadius="4" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1.2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark" Data="M 1.5,5.2 L 4.5,8.2 L 9.5,1.4" Visibility="Collapsed" Width="10" Height="9" Stretch="Fill" Stroke="{DynamicResource FinalCheckCheckMarkBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#1AA2E6DD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="Transparent"/>
                                <Setter TargetName="CheckBoxBox" Property="Background" Value="{DynamicResource FinalCheckCheckedBoxBrush}"/>
                                <Setter TargetName="CheckBoxBox" Property="BorderBrush" Value="{DynamicResource FinalCheckCheckedBoxBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CachedSessionItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <DataTemplate x:Key="CachedSessionOptionTemplate">
            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource CachedSessionTextBrush}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
        </DataTemplate>
        <Style x:Key="CachedSessionComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource NoteInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,34,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CachedSessionItem}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CachedSessionOptionTemplate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/>
                            <TextBox x:Name="PART_EditableTextBox" Margin="10,0,34,0" Padding="0" VerticalContentAlignment="Center"
                                     Text="{Binding Text, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <ToggleButton Focusable="False" ClickMode="Press" HorizontalAlignment="Right" Width="32" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" CornerRadius="0,12,12,0">
                                            <Path Data="M 0,0 L 5,5 L 10,0" Width="10" Height="5" Stretch="Fill" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Margin="0,4,0,0" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"
                                        Background="{DynamicResource ActivityPanelBrush}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="12" Padding="5">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox x:Name="WindowFitViewbox" Stretch="Uniform" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="WindowScaleRoot" Width="1280" Height="720" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" ClipToBounds="True">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,1280,720" RadiusX="22" RadiusY="22"/>
        </Grid.Clip>
        <Border x:Name="Shell" CornerRadius="22" Background="{DynamicResource ShellBrush}" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="84" ShadowDepth="8" Direction="315" Opacity="0.26" Color="#000000"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,1280,720" RadiusX="22" RadiusY="22"/>
                </Grid.Clip>
                <Path x:Name="WavePathBack" Data="M -20,440 C 190,370 380,550 580,470 C 760,400 980,555 1300,465 L1300,740 L-20,740 Z" Fill="#2B17495C" Opacity="0.75"/>
                <Path x:Name="WavePathFront" Data="M -20,500 C 230,430 420,615 680,525 C 880,455 1080,600 1300,515 L1300,740 L-20,740 Z" Fill="#3510394A" Opacity="0.70"/>

                <Canvas>
                    <Button x:Name="SettingsButton" Canvas.Left="14" Canvas.Top="29" Width="34" Height="32" Style="{StaticResource HeaderIconButton}" ToolTip="Open settings." Click="SettingsButton_Click">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="17" FontWeight="Normal"/>
                    </Button>
                    <TextBlock x:Name="HeaderTitle" Text="Laptop QA Testing" Canvas.Left="54" Canvas.Top="26" Width="360" Height="42" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="Light" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"/>
                    <TextBox x:Name="HeaderDeviceName" Text="Device Name: loading..." Canvas.Left="56" Canvas.Top="62" Width="175" Height="20" Style="{StaticResource SelectableHeaderText}" FontSize="11.5"/>
                    <TextBox x:Name="HeaderSerial" Text="Service Tag: loading..." Canvas.Left="235" Canvas.Top="62" Width="145" Height="20" Style="{StaticResource SelectableHeaderText}" FontSize="11.5"/>
                    <Border x:Name="HeaderAssetBubble" Canvas.Left="384" Canvas.Top="58" Width="112" Height="24" CornerRadius="12" Padding="8,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <TextBox x:Name="HeaderAsset" Text="Asset: loading..." Style="{StaticResource SelectableHeaderText}" FontSize="11.5" Cursor="Hand" ToolTip="Set a missing BIOS asset tag." PreviewMouseLeftButtonDown="HeaderAsset_PreviewMouseLeftButtonDown"/>
                    </Border>
                    <TextBox x:Name="HeaderWarranty" Text="Warranty: loading..." Canvas.Left="56" Canvas.Top="80" Width="150" Height="20" Style="{StaticResource SelectableHeaderText}" FontSize="11.5"/>
                    <TextBlock x:Name="HeaderWarrantyStatus" Text="" Canvas.Left="184" Canvas.Top="79" Width="18" Height="20" FontFamily="Segoe UI Symbol" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeaderTechnician" Text="Technician: loading..." Canvas.Left="230" Canvas.Top="80" Width="190" Height="18" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="SummaryStatusBubble" Canvas.Left="545" Canvas.Top="43" Width="190" Height="32" CornerRadius="16" Background="#D9F5E6" BorderBrush="#7CCBA0" BorderThickness="1" Padding="12,4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.20" Color="#000000"/>
                        </Border.Effect>
                        <TextBlock x:Name="SummaryStatus" Text="Ready" Foreground="#12633D" FontSize="14" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="CachedSessionsLabel" Text="Cached Sessions" Canvas.Left="760" Canvas.Top="25" Width="180" Height="17" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CachedSessionPicker" Canvas.Left="760" Canvas.Top="45" Width="370" Height="34"
                              Style="{StaticResource CachedSessionComboBox}" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                              DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName"
                              ToolTip="Search saved QA sessions by service tag, date, or time. Sessions are retained for 90 days."
                              SelectionChanged="CachedSessionPicker_SelectionChanged" KeyUp="CachedSessionPicker_KeyUp" DropDownOpened="CachedSessionPicker_DropDownOpened"/>
                    <TextBlock x:Name="HeaderDateTime" Text="Loading date and time..." Canvas.Left="545" Canvas.Top="16" Width="190" Height="18"
                               Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock x:Name="HeaderBatteryDots" Text="&#x25CB;&#x25CB;&#x25CB;&#x25CB;" Canvas.Left="384" Canvas.Top="83" Width="62" Height="20" Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI Symbol" FontSize="15" FontWeight="Bold" ToolTip="The rating and circles come from the Dell diagnostics log. The percentage continues to use Windows battery capacity data."/>
                    <TextBlock x:Name="HeaderBattery" Text="Battery Health: loading..." Canvas.Left="450" Canvas.Top="82" Width="340" Height="20" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" ToolTip="The rating comes from the Dell diagnostics log. The percentage continues to use Windows battery capacity data."/>

                    <Button x:Name="MinimizeButton" Canvas.Left="1168" Canvas.Top="14" Width="34" Height="30" Style="{StaticResource HeaderIconButton}" ToolTip="Minimize" Click="MinimizeButton_Click">
                        <Grid Width="34" Height="30">
                            <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Canvas.Left="1210" Canvas.Top="14" Width="34" Height="30" Style="{StaticResource HeaderIconButton}" ToolTip="Close" Click="CloseButton_Click">
                        <Grid Width="34" Height="30">
                            <Rectangle Width="13" Height="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="13" Height="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="-45"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Button>

                    <Popup x:Name="PowerMenuPopup" PlacementTarget="{Binding ElementName=PowerButton}" Placement="Top" HorizontalOffset="-150" VerticalOffset="-4" AllowsTransparency="True" StaysOpen="False">
                        <Border x:Name="PowerMenuPanel" Background="{DynamicResource ActivityPanelBrush}" BorderBrush="{DynamicResource PanelStroke}" BorderThickness="1" CornerRadius="16" Padding="8" Width="190" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.24" Color="#0B2028"/>
                            </Border.Effect>
                            <StackPanel>
