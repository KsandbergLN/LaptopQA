<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assets\app-icon.ico" />
    <None Remove="assets\app-icon-preview.png" />
    <Resource Include="assets\app-icon.ico" />
    <None Include="assets\app-icon-preview.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Laptop-QA-Config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Launcher\**\*.cs" />
    <Compile Remove="macos\**\*.cs" />
    <Compile Remove="Shared\UiLocalization.cs" />
    <None Remove="Launcher\**\*" />
    <Compile Include="Shared\UiLocalization.cs" Link="UiLocalization.cs" />
    <EmbeddedResource Include="Shared\ui-translations.json" LogicalName="LaptopQA.ui-translations.json" Condition="Exists('Shared\ui-translations.json')" />
  </ItemGroup>

</Project>
